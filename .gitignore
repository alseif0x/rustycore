# Rust build artifacts
/target/
**/*.rs.bk

# Binaries at root (release builds copied here)
/bnet-server
/world-server

# SSL certificates (sensitive)
*.pem
*.pfx

# Config files with credentials (use .dist versions)
BNetServer.conf
WorldServer.conf

# Logs
Logs/
*.log
*.pkt
# ...but committed capture-diff golden fixtures (PKT 3.1) must be tracked.
!crates/capture-diff/flows/**/*.pkt

# Github Page
docs/wiki/.vitepress/cache/
docs/wiki/.vitepress/dist/
docs/wiki/node_modules/

# Local DB config
/my.cnf

# Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# OpenClaw agent internal dirs (not for public repo)
.agent/
.agents/*
.claude/
.openclaw/
.trae/
memory/
skills/
skills-lock.json

# Repository-scoped agent skills shared by the RustyCore team. Keep this as an
# allowlist: future scripts/assets need an intentional exception so local
# credentials, certificates, logs, and generated files stay ignored.
!.agents/skills/
.agents/skills/**
!.agents/skills/**/
!.agents/skills/*/SKILL.md
!.agents/skills/*/agents/openai.yaml
!.agents/skills/*/references/**/*.md

# OpenClaw workspace files (private)
SOUL.md
SOUL_QWEN.md
USER.md
MEMORY.md
HEARTBEAT.md
IDENTITY.md
INVENTORY.md
PLAN.md
TOOLS.md

# Compiled binaries at root
world-server-rust
world-server-rust.old
world-server-bin

# Python bytecode from the tools/ scripts (check_architecture.py, codex_review_gate.py)
__pycache__/
*.pyc
